<?xml version="1.0" encoding="utf-8"?>
<!-- 108dp adaptive-icon canvas; artwork stays inside the 66dp safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chat bubble -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,30 H69 A9,9 0 0 1 78,39 V61 A9,9 0 0 1 69,70 H39 A9,9 0 0 1 30,61 V39 A9,9 0 0 1 39,30 Z" />
    <!-- Bubble tail -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,64 L33,80 L50,68 Z" />

    <!-- Streaming text lines, each shorter than the last -->
    <path
        android:pathData="M40,42 H68"
        android:strokeColor="#1F3A68"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M40,50.5 H62"
        android:strokeColor="#1F3A68"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M40,59 H50"
        android:strokeColor="#1F3A68"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- Cursor: the next token arriving -->
    <path
        android:fillColor="#FFB74D"
        android:pathData="M55,55 H59.5 V63 H55 Z" />
</vector>
